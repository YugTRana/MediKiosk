# MediKiosk Backend Configuration
PORT=3000

# Database Configuration
DATABASE_URL="file:./dev.db"

# JWT Secret for Session/Token-based Auth
JWT_SECRET="your_secure_jwt_secret_here"

# AI Engines & Dialogue Reasoning (Phase 2)
# Google Gemini API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gcp_api_key_here

# ==============================================================================
# BHASHINI (AI4BHARAT / DIGITAL INDIA) SPEECH AI GATEWAY (Phase 3)
# ==============================================================================
# Indian-language ASR (Speech-to-Text) and TTS (Text-to-Speech)
# Obtain credentials from: https://bhashini.gov.in/ulca / https://bhashini.gov.in/en/
# If unset, MediKiosk automatically uses the built-in browser Web Speech API fallback.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ==============================================================================
# REAL SMS GATEWAY API KEYS (To receive real SMS on your Indian mobile phone)
# ==============================================================================
# 1. Fast2SMS (Free signup credit for Indian +91 numbers: https://www.fast2sms.com)
FAST2SMS_API_KEY=

# 2. 2Factor.in Gateway (https://2factor.in)
TWO_FACTOR_API_KEY=

# 3. Twilio SMS Gateway (https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

